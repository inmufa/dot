# Hardware profile: one NVIDIA 24 GB card, CUDA 12 image. Unverified starting point.
# Needs the NVIDIA Container Toolkit on the host.
# Apply with: make profile NAME=nvidia-24gb
DOT_GPU_BACKEND=cuda
DOT_LLM_IMAGE_TAG=server-cuda-b12464
DOT_LLM_NGL=99
DOT_LLM_PARALLEL=4
DOT_LLM_CTX_PER_SLOT=65536
DOT_LLM_KV_K=q8_0
DOT_LLM_KV_V=q8_0
DOT_LLM_FA=on
DOT_LLM_MEM_LIMIT=8g
DOT_VISION=gpu
DOT_LLM_MEM_LIMIT_VISION=8g
DOT_LLM_EXTRA_ARGS=
DOT_VOICE=on
DOT_VOICE_THREADS=4
DOT_CHAT_RATE_PER_MIN=60
DOT_CHAT_RATE_BURST=20
# NVIDIA has no amdgpu sysfs counters: VRAM telemetry stays empty.
DOT_VRAM_SYSFS_DIR=../config/dot
