# Hardware profile: RX 580 8 GB, Vulkan, ~6 GB free RAM (the measured default).
# Apply with: make profile NAME=rx580-8gb
DOT_GPU_BACKEND=vulkan
DOT_LLM_IMAGE_TAG=server-vulkan-b12464
DOT_LLM_NGL=99
# Single slot: 2 slots * 32768 = 65536 total KV OOM-crashed the 8 GB card. One slot
# keeps all VRAM for one context instead of splitting it.
DOT_LLM_PARALLEL=1
# Context per slot; the server gets -c = per slot * parallel. 49152 sits ~85-91% VRAM
# on this card; drop toward 40960 if a near-full context starts OOM crash-looping.
DOT_LLM_CTX_PER_SLOT=49152
DOT_LLM_KV_K=q8_0
DOT_LLM_KV_V=q8_0
DOT_LLM_FA=on
DOT_LLM_MEM_LIMIT=1536m
# Projector: off | cpu (-mmdev none, ~0 VRAM, needs the 4g limit below) | gpu.
# Enable: make profile NAME=rx580-8gb SET=DOT_VISION=cpu. Never the Intel iGPU, see docs/vision-gate.md.
DOT_VISION=off
# Host RAM for the projector weights and image buffers (1536m was OOM-killed).
DOT_LLM_MEM_LIMIT_VISION=4g
DOT_LLM_EXTRA_ARGS=
DOT_VOICE=on
DOT_VOICE_THREADS=4
DOT_CHAT_RATE_PER_MIN=30
DOT_CHAT_RATE_BURST=10
