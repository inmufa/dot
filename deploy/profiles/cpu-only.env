# Hardware profile: no GPU, CPU inference. Slow; one slot, small context. Unverified.
# Apply with: make profile NAME=cpu-only
DOT_GPU_BACKEND=cpu
DOT_LLM_IMAGE_TAG=server-b12464
DOT_LLM_NGL=0
DOT_LLM_PARALLEL=1
DOT_LLM_CTX_PER_SLOT=16384
DOT_LLM_KV_K=q8_0
DOT_LLM_KV_V=q8_0
DOT_LLM_FA=on
DOT_LLM_MEM_LIMIT=12g
DOT_VISION=off
DOT_LLM_MEM_LIMIT_VISION=14g
DOT_LLM_EXTRA_ARGS=
DOT_VOICE=off
DOT_VOICE_THREADS=2
DOT_CHAT_RATE_PER_MIN=10
DOT_CHAT_RATE_BURST=4
