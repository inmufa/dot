# Hardware profile: several NVIDIA cards (about 48 GB total), CUDA 12 image. Unverified.
# Layers are split across all visible cards; pin cards in compose.local.yml if needed.
# Apply with: make profile NAME=nvidia-48gb-multi
DOT_GPU_BACKEND=cuda
DOT_LLM_IMAGE_TAG=server-cuda-b12464
DOT_LLM_NGL=99
DOT_LLM_PARALLEL=8
DOT_LLM_CTX_PER_SLOT=65536
DOT_LLM_KV_K=q8_0
DOT_LLM_KV_V=q8_0
DOT_LLM_FA=on
DOT_LLM_MEM_LIMIT=16g
DOT_VISION=gpu
DOT_LLM_MEM_LIMIT_VISION=16g
DOT_LLM_EXTRA_ARGS=--split-mode layer
DOT_VOICE=on
DOT_VOICE_THREADS=8
DOT_CHAT_RATE_PER_MIN=120
DOT_CHAT_RATE_BURST=40
DOT_VRAM_SYSFS_DIR=../config/dot
