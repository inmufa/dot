# Hardware profile: one AMD 16 GB card on ROCm. Unverified starting point.
# Needs /dev/kfd and a ROCm-supported GPU (else HSA_OVERRIDE_GFX_VERSION in compose.local.yml).
# Apply with: make profile NAME=amd-rocm-16gb
DOT_GPU_BACKEND=rocm
DOT_LLM_IMAGE_TAG=server-rocm-b12464
DOT_LLM_NGL=99
DOT_LLM_PARALLEL=3
DOT_LLM_CTX_PER_SLOT=49152
DOT_LLM_KV_K=q8_0
DOT_LLM_KV_V=q8_0
DOT_LLM_FA=on
DOT_LLM_MEM_LIMIT=6g
DOT_VISION=gpu
DOT_LLM_MEM_LIMIT_VISION=6g
DOT_LLM_EXTRA_ARGS=
DOT_VOICE=on
DOT_VOICE_THREADS=4
DOT_CHAT_RATE_PER_MIN=45
DOT_CHAT_RATE_BURST=15
