# Server-side only. Never prefix with NEXT_PUBLIC_.
DOT_URL=http://127.0.0.1:8000
DOT_API_TOKEN=
# Comma list of optional panels backed by endpoints the backend may not have yet: tasks,mcp,gpu,memory
DOT_FEATURES=
# Set to 1 only when the backend is a compose service name, not loopback.
DOT_ALLOW_NON_LOOPBACK=
# Extra Host header values accepted (comma list), e.g. dot.local:3000
DOT_WEB_ALLOWED_HOSTS=
