# Copy to .env. Never commit .env.
DOT_API_TOKEN=change-me-to-a-long-random-string
DOT_ENV=dev
DOT_LLM_BASE_URL=http://127.0.0.1:8080/v1
DOT_SANDBOX_URL=http://127.0.0.1:8090
DOT_WORKSPACE=./workspace
# Model file inside ./models, chosen by the M1 benchmark
DOT_MODEL_FILE=Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf
# Render node of the discrete GPU (ls -l /dev/dri/by-path | grep 01:00)
DOT_GPU_RENDER_NODE=/dev/dri/renderD129
# Host group ids for GPU access: getent group video render
DOT_VIDEO_GID=44
DOT_RENDER_GID=990
DOT_LLM_CONTEXT_LIMIT=32768
# Thinking on|off|auto and sampling (defaults = Qwen thinking-mode recommendation)
DOT_LLM_THINKING=on
DOT_LLM_TEMPERATURE=0.6
DOT_LLM_TOP_P=0.95
DOT_LLM_TOP_K=20
DOT_LLM_PRESENCE_PENALTY=0
# Shared secret between backend and sandbox (compose requires it)
DOT_SANDBOX_TOKEN=change-me-to-another-long-random-string
# Host dir mounted as the sandbox /workspace; create it first: mkdir workspace
DOT_WORKSPACE_DIR=../../workspace

# SearXNG secret (compose requires it): openssl rand -hex 32
SEARXNG_SECRET=change-me-to-a-third-long-random-string
# Browser worker token, required for `make up-browser`: openssl rand -hex 32
DOT_BROWSER_TOKEN=
# Web cockpit feature flags (comma list, optional)
DOT_FEATURES=
# IANA time zone for scheduled jobs (cron runs in it)
DOT_TIMEZONE=UTC
# Env names that ${VAR} in .dot/settings.json mcpServers (headers, env) may read.
# The backend container must also receive them (add to compose environment).
DOT_MCP_ENV_ALLOWLIST=
# `make models`: download source (one of URL or REPO) and the expected SHA256 (64 hex).
DOT_MODEL_URL=
DOT_MODEL_REPO=
DOT_MODEL_SHA256=
# Public API limits (backend): message length, request body bytes, chat starts per minute and burst.
# Passed through to the backend container by compose (defaults shown).
DOT_MAX_MESSAGE_CHARS=100000
DOT_MAX_BODY_BYTES=1048576
DOT_CHAT_RATE_PER_MIN=30
DOT_CHAT_RATE_BURST=10
